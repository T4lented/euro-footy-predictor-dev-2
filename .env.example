# Optional Live API Keys (if connecting to external providers)
# The CLI works completely out of the box without any keys!

FOOTBALL_DATA_API_KEY=your_football_data_org_api_key_here
API_FOOTBALL_KEY=your_rapidapi_key_here
ODDS_API_KEY=your_the_odds_api_key_here
DEFAULT_LEAGUE=PL

# Sentry error monitoring (free tier at sentry.io — the DSN is a public identifier, safe for client bundles)
VITE_SENTRY_DSN=your_sentry_dsn_here
