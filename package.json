{
  "name": "euro-footy-predictor",
  "version": "1.0.0",
  "description": "CLI tool for daily European Top 10 League fixtures and 12-factor predictive win/draw probabilities",
  "type": "module",
  "main": "src/cli.js",
  "bin": {
    "footy": "./bin/footy.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
