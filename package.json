    "boxen": "7.1.1",
    "chalk": "5.6.2",
    "cli-table3": "0.6.5",
    "clsx": "2.1.1",
    "commander": "12.1.0",
    "dotenv": "16.6.1",
    "framer-motion": "11.18.2",
    "lucide-react": "0.383.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "2.6.1"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "10.5.4",
